# ── Runtime ───────────────────────────────────────────────────────────────────
# NODE_ENV was previously set nowhere, which meant `secure` on the refresh
# cookie was always false — including in production. Render does not set it
# either. Set it here and in the platform's environment.
NODE_ENV=development
BACKEND_PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ecommerce

# ── Auth ──────────────────────────────────────────────────────────────────────
# Durations, not milliseconds. These were JWT_ACCESS_EXPIRATION_MS=900000
# ("15 minutes") but jsonwebtoken reads a numeric expiresIn as SECONDS, so the
# access token actually lived ~10 days while the refresh token, passed as a
# string, correctly lived 7 days. Use duration strings so the unit is explicit.
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string

# CORS — explicit origins. Never "*" with credentials.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Password reset ────────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRATION_MS=1h

# ── Brute-force lockout ───────────────────────────────────────────────────────
# Keyed on a hash of the email, so addresses with no account are throttled too.
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_DURATION_MS=900000
BRUTE_FORCE_WINDOW_MS=900000

# ── Rate limits (per IP, per minute) ──────────────────────────────────────────
# Per-IP limits bound the caller (credential stuffing). The per-account limit
# above bounds the victim. Both are needed; either alone leaves a gap.
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=10
RATE_LIMIT_FORGOT=3
RATE_LIMIT_RESET=5
RATE_LIMIT_REGISTER=5

# ── Email (optional) ──────────────────────────────────────────────────────────
# Absent in development: EmailModule swaps in DevEmailService, which writes to
# the console instead. No third-party calls are made without these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
